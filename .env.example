# Slot Environment Configuration
# Controls which slot instance and manifest to load.
# Common values today: testnet | prods3
# Slot RPC, Torii URL, Relay URL, World Address, and Game View contract
# are all resolved dynamically from version.json and remote manifest.
MANIFEST_SLOT_ENV=dev

# Starknet Configuration (Optional - para ejecutar transacciones)
# Si no se configuran, el bot funcionará en modo solo lectura
# URL JSON-RPC de Starknet. Usar un endpoint activo del provider elegido.
STARKNET_RPC_URL=https://your-starknet-sepolia-rpc.example/rpc/v0_9

# RPC usado por workers/colas/background. Si no se define, usa STARKNET_RPC_URL.
BACKGROUND_STARKNET_RPC_URL=

# Private key de la cuenta que ejecutará transacciones
STARKNET_PRIVATE_KEY=0x...

# Dirección de la cuenta en Starknet
STARKNET_ADDRESS=0x...
# Upgraded cards contract exposing migrate_cards.
STARKNET_NFT_CONTRACT_ADDRESS=0x...
XP_SYSTEM_CONTRACT_ADDRESS=0x...

PROFILE_SYSTEM_CONTRACT_ADDRESS=0x...
PROGRESSION_SYSTEM_CONTRACT_ADDRESS=0x...

# Slot/Katana write account.
# Used for Dojo world transactions such as generate_daily_missions.
# This account must be deployed on the Slot instance selected by MANIFEST_SLOT_ENV.
SLOT_MASTER_ADDRESS=0x...
SLOT_MASTER_PRIVATE_KEY=0x...

# Celo / EVM Configuration (Optional - para juegos cuyo destino sea celo)
# En este worker Celo siempre usa mainnet.
# En Celo este worker usa un unico contrato: Profile.
CELO_RPC_URL=https://forno.celo.org
CELO_PRIVATE_KEY=0x...
CELO_ADDRESS=0x...
CELO_PROFILE_SYSTEM_CONTRACT_ADDRESS=0x...
# Optional; defaults to the official USDm contract on Celo Mainnet.
CELO_REWARD_TOKEN_CONTRACT_ADDRESS=0x765DE816845861e75A25fCA122bb6898B8B1282a
WORKER_BLOCKCHAIN_FILTER=slot,starknet,celo

# Supabase Configuration (for persistent transaction queue)
# Estas credenciales deben ser las mismas que jokers-of-neon-api
SUPABASE_URL=https://jopurrudzfwcwbgqjzcs.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only secret. Required by the persistent queue; multicall additionally
# uses it because executor claims return a signing key. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Transaction execution. Apply the parallel queue migration before enabling
# multicall. Set max concurrent batches to 0 to drain submitted work without
# claiming new Starknet batches.
TRANSACTION_EXECUTION_MODE=sequential
STARKNET_BATCH_SIZE=5
STARKNET_BATCH_WAIT_TIME_MS=1000
STARKNET_MAX_CONCURRENT_BATCHES=6
# Optional allowlist of executor_accounts IDs eligible for this worker.
STARKNET_EXECUTOR_IDS=
TRANSACTION_QUEUE_POLL_INTERVAL_MS=500
TRANSACTION_QUEUE_LEASE_MS=600000
# Reconcile submitted hashes that remain unknown; explicit mempool evictions
# are handled immediately after checking the executor nonce.
STARKNET_SUBMITTED_UNKNOWN_TIMEOUT_MS=120000

# Game Data API (for fetching full game state)
# Default: https://jokers-of-neon-data.vercel.app/api/full-game
FULL_GAME_API_URL=https://jokers-of-neon-data.vercel.app/api/full-game


# GraphQL endpoint for fetching leaderboard data
LEADERBOARD_GRAPHQL_URL=https://api.cartridge.gg/x/mainnet-jokers-profile/torii/graphql

# Game Stats API for fetching game ID ranges by date
GAME_STATS_API_URL=https://your-stats-api.com
GAME_STATS_API_KEY=your-api-key

# Cron schedules for pack distribution (UTC time)
# Format: minute hour dayOfMonth month dayOfWeek
# Default: 06:05 UTC daily, 06:10 UTC every Monday (after 6am UTC day boundary)
DAILY_CRON_SCHEDULE=5 6 * * *
WEEKLY_CRON_SCHEDULE=10 6 * * 1

# --- Unified worker modules (all default safe for local dev) ---
TORII_LISTENER_ENABLED=true
TRANSACTION_QUEUE_ENABLED=true
CRON_JOBS_ENABLED=true
NOTIFICATIONS_ENABLED=false
MISSIONS_GENERATION_ENABLED=true
GAME_AGENT_ENABLED=false
PACK_DISTRIBUTION_ENABLED=false

# Mission generation (enqueued to torii_worker_intent_queue)
# Aliases: PRIVATE_KEY / ADDRESS also accepted for STARKNET_*
DAILY_MISSION_CRON_SCHEDULE=5 6 * * *
WEEKLY_MISSION_CRON_SCHEDULE=10 6 * * 1
GENERATE_DAILY_MISSIONS_ENABLED=true
GENERATE_WEEKLY_MISSIONS_ENABLED=true

# Push notifications (requires NOTIFICATIONS_ENABLED=true + Firebase)
DATA_API_URL=https://jokers-of-neon-data.vercel.app
NOTIFICATIONS_CRON_SCHEDULE=0 * * * *
FREE_PACKS_CRON_SCHEDULE=*/15 * * * *
CUSTOM_NOTIFICATIONS_CRON_SCHEDULE=0 * * * *
DAILY_MISSIONS_NOTIFICATION_HOUR=20
NOTIFICATIONS_MIN_HOUR=9
NOTIFICATIONS_MAX_HOUR=21
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=
NOTIFICATIONS_DEBUG_WALLET=

# Game agent burners
BURNER_ACCOUNTS=[]
INTERVAL_HOURS=13
PLAYBACK_API_URL=
