# Slot Environment Configuration
# Controls which slot instance and manifest to load.
# Common values today: dev | prods3
# Slot RPC, Torii URL, Relay URL, World Address, and Game View contract
# are all resolved dynamically from version.json and remote manifest.
MANIFEST_SLOT_ENV=dev

# Starknet Configuration (Optional - para ejecutar transacciones)
# Si no se configuran, el bot funcionará en modo solo lectura
# URL JSON-RPC de Starknet. Usar un endpoint activo del provider elegido.
STARKNET_RPC_URL=https://your-starknet-sepolia-rpc.example/rpc/v0_9

# Private key de la cuenta que ejecutará transacciones
STARKNET_PRIVATE_KEY=0x...

# Dirección de la cuenta en Starknet
STARKNET_ADDRESS=0x...
XP_SYSTEM_CONTRACT_ADDRESS=0x...

PROFILE_SYSTEM_CONTRACT_ADDRESS=0x...
PROGRESSION_SYSTEM_CONTRACT_ADDRESS=0x...

# Celo / EVM Configuration (Optional - para juegos cuyo destino sea celo)
# En este worker Celo siempre usa mainnet.
# En Celo este worker usa un unico contrato: Profile.
CELO_RPC_URL=https://forno.celo.org
CELO_PRIVATE_KEY=0x...
CELO_ADDRESS=0x...
CELO_PROFILE_SYSTEM_CONTRACT_ADDRESS=0x...
WORKER_BLOCKCHAIN_FILTER=starknet,celo

# Supabase Configuration (for persistent transaction queue)
# Estas credenciales deben ser las mismas que jokers-of-neon-api
SUPABASE_URL=https://jopurrudzfwcwbgqjzcs.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Game Data API (for fetching full game state)
# Default: https://jokers-of-neon-data.vercel.app/api/full-game
FULL_GAME_API_URL=https://jokers-of-neon-data.vercel.app/api/full-game

# Pack Distribution Configuration
# Enable/disable automatic pack distribution from leaderboard rankings
PACK_DISTRIBUTION_ENABLED=false

# GraphQL endpoint for fetching leaderboard data
LEADERBOARD_GRAPHQL_URL=https://api.cartridge.gg/x/mainnet-jokers-profile/torii/graphql

# Game Stats API for fetching game ID ranges by date
GAME_STATS_API_URL=https://your-stats-api.com
GAME_STATS_API_KEY=your-api-key

# Cron schedules for pack distribution (UTC time)
# Format: minute hour dayOfMonth month dayOfWeek
# Default: 06:05 UTC daily, 06:10 UTC every Monday (after 6am UTC day boundary)
DAILY_CRON_SCHEDULE=5 6 * * *
WEEKLY_CRON_SCHEDULE=10 6 * * 1
